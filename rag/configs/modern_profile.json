{
  "device": "cpu",
  "chunking": {
    "strategy": "structure_aware",
    "params": {"max_tokens": 420, "overlap_tokens": 60, "min_tokens": 80}
  },
  "retrieval": {
    "top_k": 8,
    "candidates_k": 60,
    "embed_model": "models/Qwen3-Embedding-0.6B",
    "query_instruction": "Given a cybersecurity audit benchmark question, retrieve the audit evidence that answers it",
    "use_hybrid": true,
    "use_reranker": true,
    "reranker_model": "models/Qwen3-Reranker-0.6B",
    "use_parent_child": true,
    "use_graph_retrieval": true,
    "use_late_interaction": false,
    "late_interaction_model_path": "models/colbert",
    "use_visual_retrieval": false,
    "visual_model_path": "models/vidore/colqwen2-v1.0",
    "use_crag": true,
    "use_hyde": false
  },
  "icl": {"strategy": "retrieval_few_shot", "k": 4, "example_bank_path": "sample_data/icl_example_bank.json"},
  "prompt_version": "v2_evidence_review",
  "generation": {
    "model_name": "qwen3:8b",
    "temperature": 0.0,
    "seed": 42,
    "num_predict": 512,
    "top_p": 1.0,
    "think": false,
    "use_chat_api": true,
    "enforce_schema": true
  },
  "verification": {"use_claim_verifier": true},
  "pass_threshold_pct": 70.0,
  "benchmark_questions_path": "sample_data/benchmark_questions.json",
  "audit_reports": [{"report_id": "AR-2026-001", "path": "sample_data/sample_report_001.txt", "gold_labels": {}}]
}
